---
import Layout from '../layouts/layout.astro'
import Logo from "../components/logo.astro"
import styles from "./index.module.scss"
import Section from "../components/section.astro"
import Navigation from "../components/index/navigation.astro"
import Socials from "../components/index/socials.astro"
import Copyright from "../components/copyright.astro";
---

<Layout title="Gosub Web Browser Engine">
    <header class={styles.header}>
        <Logo size={128}/>
        <Navigation/>
        <Socials/>
    </header>


    <Section first>
    <h1>Contact us</h1>
    The best way to contact us is through either email at info at gosub.io, or via <a href="https://chat.developer.gosub.io">the developer chat</a>.
    </Section>

    <footer>
        <Socials/>
        <Copyright/>
    </footer>
</Layout>
