---
/**
 * DESIGN 4: GEOMETRIC / ART DECO
 * 
 * Aesthetic: 1920s Art Deco meets modern tech. Deep navy background with gold/brass
 * accents, sharp geometric patterns, symmetrical layouts, sunburst motifs,
 * stepped/ziggurat shapes. Luxury meets engineering precision.
 * The memorable thing: the bold geometric hero pattern and gold-on-navy color story.
 * 
 * Fonts: "Cormorant Garamond" (display) + "Jost" (body/ui)
 * Colors: Deep navy #0b1628, gold #c9a84c, cream #f5f0e8, teal #2dd4bf
 */
import Base from '../../layouts/Base.astro';
---

<Base title="Gosub — Modular Browser Engine [DESIGN 04: ART DECO]">

<style lang="scss">
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap');

:root {
  --bg: #0b1628;
  --bg-light: #0f1d34;
  --bg-card: #132240;
  --navy: #0b1628;
  --gold: #c9a84c;
  --gold-light: #e0c872;
  --gold-dim: rgba(201, 168, 76, 0.15);
  --gold-glow: rgba(201, 168, 76, 0.25);
  --cream: #f5f0e8;
  --cream-dim: rgba(245, 240, 232, 0.7);
  --cream-muted: rgba(245, 240, 232, 0.4);
  --teal: #2dd4bf;
  --border: rgba(201, 168, 76, 0.2);
  --border-subtle: rgba(245, 240, 232, 0.08);
  --display: 'Cormorant Garamond', Georgia, serif;
  --body: 'Jost', 'Helvetica Neue', sans-serif;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
}

body {
  background: var(--bg);
  color: var(--cream);
  font-family: var(--body);
  font-size: 1rem;
  font-weight: 300;
  line-height: 1.7;
  overflow-x: hidden;
}

::selection {
  background: var(--gold);
  color: var(--navy);
}

a {
  color: var(--gold);
  text-decoration: none;
  transition: color 0.2s;
  &:hover {
    color: var(--gold-light);
  }
}

// ===== DECORATIVE PATTERNS =====
.deco-line {
  display: flex;
  align-items: center;
  gap: 1rem;
  
  &::before, &::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }
  
  .diamond {
    width: 8px;
    height: 8px;
    background: var(--gold);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
}

// ===== NAV =====
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 1.25rem 3rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(11, 22, 40, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  
  @media (max-width: 768px) {
    padding: 1rem 1.5rem;
  }
  
  &__logo {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--cream);
    text-decoration: none;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    
    &:hover { color: var(--cream); text-decoration: none; }
    
    .dot {
      color: var(--gold);
    }
  }
  
  &__links {
    display: flex;
    gap: 2rem;
    align-items: center;
    
    @media (max-width: 768px) {
      display: none;
    }
    
    a {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-weight: 400;
      color: var(--cream-muted);
      
      &:hover {
        color: var(--gold);
      }
    }
  }
}

// ===== HERO =====
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 8rem 2rem 4rem;
  position: relative;
  overflow: hidden;
  
  // Geometric background pattern
  &::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      // Sunburst from top
      conic-gradient(
        from 0deg at 50% 0%,
        transparent 0deg,
        rgba(201, 168, 76, 0.03) 10deg,
        transparent 20deg,
        rgba(201, 168, 76, 0.03) 30deg,
        transparent 40deg,
        rgba(201, 168, 76, 0.03) 50deg,
        transparent 60deg,
        rgba(201, 168, 76, 0.03) 70deg,
        transparent 80deg,
        rgba(201, 168, 76, 0.03) 90deg,
        transparent 100deg,
        rgba(201, 168, 76, 0.03) 110deg,
        transparent 120deg,
        rgba(201, 168, 76, 0.03) 130deg,
        transparent 140deg,
        rgba(201, 168, 76, 0.03) 150deg,
        transparent 160deg,
        rgba(201, 168, 76, 0.03) 170deg,
        transparent 180deg
      ),
      // Radial glow
      radial-gradient(ellipse 60% 50% at 50% 40%, var(--gold-dim), transparent);
    pointer-events: none;
  }
  
  // Stepped border bottom
  &::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent 10%, var(--gold) 30%, var(--gold) 70%, transparent 90%);
  }
  
  &__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--border);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--gold);
    margin-bottom: 3rem;
    opacity: 0;
    animation: fadeInDown 0.8s 0.2s forwards;
    
    .diamond {
      width: 6px;
      height: 6px;
      background: var(--gold);
      transform: rotate(45deg);
    }
  }
  
  &__title {
    font-family: var(--display);
    font-size: clamp(4rem, 12vw, 9rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: 1.5rem;
    position: relative;
    opacity: 0;
    animation: fadeInUp 0.8s 0.5s forwards;
    
    // Gold underline decoration
    &::after {
      content: '';
      display: block;
      width: 120px;
      height: 2px;
      background: var(--gold);
      margin: 1.5rem auto 0;
    }
  }
  
  &__subtitle {
    font-family: var(--display);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--cream-dim);
    max-width: 600px;
    margin-bottom: 3rem;
    opacity: 0;
    animation: fadeInUp 0.8s 0.8s forwards;
  }
  
  &__actions {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    animation: fadeInUp 0.8s 1.1s forwards;
  }
}

// ===== BUTTONS =====
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 2.25rem;
  font-family: var(--body);
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  border: none;
  
  &--gold {
    background: var(--gold);
    color: var(--navy);
    
    &:hover {
      background: var(--gold-light);
      color: var(--navy);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px var(--gold-glow);
      text-decoration: none;
    }
  }
  
  &--outline {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--cream);
    
    &:hover {
      border-color: var(--gold);
      color: var(--gold);
      text-decoration: none;
    }
  }
}

// ===== SECTION =====
.section {
  padding: 6rem 3rem;
  
  @media (max-width: 768px) {
    padding: 4rem 1.5rem;
  }
  
  &--alt {
    background: var(--bg-light);
  }
  
  &__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  &__header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  &__label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--gold);
    display: block;
    margin-bottom: 1rem;
  }
  
  &__title {
    font-family: var(--display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    
    em {
      font-style: italic;
      color: var(--gold);
    }
  }
}

// ===== FEATURES =====
.features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  
  @media (max-width: 900px) {
    grid-template-columns: repeat(2, 1fr);
  }
  
  @media (max-width: 600px) {
    grid-template-columns: 1fr;
  }
  
  &__card {
    padding: 2.5rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    text-align: center;
    transition: all 0.3s;
    position: relative;
    
    // Corner decorations
    &::before, &::after {
      content: '';
      position: absolute;
      width: 16px;
      height: 16px;
      border-color: var(--gold);
      border-style: solid;
      transition: all 0.3s;
      opacity: 0.3;
    }
    
    &::before {
      top: 8px;
      left: 8px;
      border-width: 1px 0 0 1px;
    }
    
    &::after {
      bottom: 8px;
      right: 8px;
      border-width: 0 1px 1px 0;
    }
    
    &:hover {
      border-color: var(--gold);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.3);
      
      &::before, &::after {
        opacity: 1;
      }
      
      .features__icon {
        color: var(--gold);
      }
    }
  }
  
  &__icon {
    font-family: var(--display);
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--cream-muted);
    margin-bottom: 1.5rem;
    transition: color 0.3s;
  }
  
  &__title {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  
  &__desc {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--cream-muted);
    line-height: 1.7;
  }
}

// ===== PIPELINE =====
.pipeline {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
  
  @media (max-width: 900px) {
    grid-template-columns: 1fr;
  }
  
  &__text {
    p {
      color: var(--cream-dim);
      margin-bottom: 1.5rem;
      font-weight: 300;
    }
  }
  
  &__stages {
    position: relative;
    padding-left: 3rem;
    
    // Vertical line
    &::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background: linear-gradient(to bottom, var(--gold), var(--border), transparent);
    }
  }
  
  &__stage {
    position: relative;
    padding: 1.25rem 0;
    padding-left: 0;
    
    // Diamond marker
    &::before {
      content: '';
      position: absolute;
      left: -3rem;
      top: 1.6rem;
      width: 8px;
      height: 8px;
      background: var(--gold);
      transform: rotate(45deg) translateX(-50%);
    }
    
    h4 {
      font-family: var(--display);
      font-size: 1.25rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      margin-bottom: 0.25rem;
    }
    
    p {
      font-size: 0.8125rem;
      color: var(--cream-muted);
      font-weight: 300;
    }
  }
}

// ===== STATUS =====
.status {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  
  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
  
  &__text {
    p {
      color: var(--cream-dim);
      font-weight: 300;
      margin-bottom: 1rem;
    }
  }
  
  &__meters {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  &__meter {
    &-head {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    
    &-name {
      font-size: 0.8125rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 400;
    }
    
    &-val {
      font-size: 0.75rem;
      color: var(--cream-muted);
      font-weight: 300;
    }
    
    &-bar {
      height: 3px;
      background: var(--border-subtle);
      position: relative;
    }
    
    &-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--gold), var(--gold-light));
      position: absolute;
      top: 0;
      left: 0;
    }
  }
}

// ===== CONTRIBUTE =====
.contribute {
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  
  &__desc {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 400;
    font-style: italic;
    color: var(--cream-dim);
    margin-bottom: 3rem;
  }
  
  &__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    text-align: left;
    margin-bottom: 3rem;
    
    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }
  
  &__heading {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  
  &__list {
    list-style: none;
    
    li {
      font-size: 0.875rem;
      font-weight: 300;
      color: var(--cream-dim);
      padding: 0.375rem 0;
      
      &::before {
        content: '\25C6 ';
        color: var(--gold);
        font-size: 0.5rem;
        vertical-align: middle;
        margin-right: 0.5rem;
      }
    }
  }
  
  &__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    
    a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.875rem 1.25rem;
      border: 1px solid var(--border);
      color: var(--cream);
      font-size: 0.875rem;
      font-weight: 400;
      transition: all 0.2s;
      
      &:hover {
        border-color: var(--gold);
        background: var(--gold-dim);
        color: var(--cream);
        
        span { color: var(--gold); }
      }
      
      span {
        color: var(--cream-muted);
        transition: color 0.2s;
      }
    }
  }
}

// ===== FOOTER =====
.footer {
  padding: 3rem;
  text-align: center;
  
  &__line {
    margin-bottom: 1.5rem;
  }
  
  &__copy {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream-muted);
    font-weight: 300;
  }
  
  &__links {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-top: 0.75rem;
    
    a {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--cream-muted);
      
      &:hover { color: var(--gold); }
    }
  }
}

// ===== ANIMATIONS =====
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}

// Scrollbar
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--gold); opacity: 0.5; border-radius: 3px; }
</style>

<!-- NAV -->
<nav class="nav">
  <a href="/4" class="nav__logo">GOSUB<span class="dot">&middot;</span></a>
  <div class="nav__links">
    <a href="#features">Features</a>
    <a href="#architecture">Architecture</a>
    <a href="#status">Status</a>
    <a href="https://github.com/gosub-io/gosub-engine">GitHub</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero__badge">
    <span class="diamond"></span>
    Open Source &middot; MIT Licensed &middot; Rust
    <span class="diamond"></span>
  </div>
  
  <h1 class="hero__title">GOSUB</h1>
  
  <p class="hero__subtitle">
    A modular browser engine built from scratch &mdash; challenging<br/>
    the browser monoculture, one composable crate at a time
  </p>
  
  <div class="hero__actions">
    <a href="https://github.com/gosub-io/gosub-engine" class="btn btn--gold">View on GitHub</a>
    <a href="#community" class="btn btn--outline">Join Development</a>
  </div>
</section>

<div class="deco-line" style="padding: 0 3rem;">
  <span class="diamond"></span>
</div>

<!-- FEATURES -->
<section class="section" id="features">
  <div class="section__inner">
    <div class="section__header">
      <span class="section__label">What Sets Us Apart</span>
      <h2 class="section__title">Engineered with <em>Purpose</em></h2>
    </div>
    
    <div class="features">
      <article class="features__card">
        <div class="features__icon">I</div>
        <h3 class="features__title">Modular Design</h3>
        <p class="features__desc">Trait-based architecture lets you swap the JS engine, renderer, or layout system without forking.</p>
      </article>
      <article class="features__card">
        <div class="features__icon">II</div>
        <h3 class="features__title">Dual Rendering</h3>
        <p class="features__desc">GPU-accelerated via Vello or CPU-based Cairo. The drawing backend is pluggable by design.</p>
      </article>
      <article class="features__card">
        <div class="features__icon">III</div>
        <h3 class="features__title">Built in Rust</h3>
        <p class="features__desc">Memory safety without garbage collection. Concurrency without data races. Performance without compromise.</p>
      </article>
      <article class="features__card">
        <div class="features__icon">IV</div>
        <h3 class="features__title">Community-Driven</h3>
        <p class="features__desc">No corporate backing. MIT licensed. Built entirely by volunteers who believe in browser diversity.</p>
      </article>
      <article class="features__card">
        <div class="features__icon">V</div>
        <h3 class="features__title">Standards First</h3>
        <p class="features__desc">We follow web specifications, not existing implementations. Cleaner architecture, better compatibility.</p>
      </article>
      <article class="features__card">
        <div class="features__icon">VI</div>
        <h3 class="features__title">Engine Diversity</h3>
        <p class="features__desc">The web runs on three engines. That's not healthy. We're building the fourth &mdash; module by module.</p>
      </article>
    </div>
  </div>
</section>

<!-- ARCHITECTURE -->
<section class="section section--alt" id="architecture">
  <div class="section__inner">
    <div class="section__header">
      <span class="section__label">Technical Architecture</span>
      <h2 class="section__title">The <em>Pipeline</em></h2>
    </div>
    
    <div class="pipeline">
      <div class="pipeline__text">
        <p>
          Gosub's architecture separates concerns into distinct stages communicating
          through well-defined interfaces. Each stage is an independent module.
        </p>
        <p>
          Want a headless document processor? A custom rendering pipeline? 
          A specialized web crawler? Pick your components and build your vision.
        </p>
      </div>
      
      <div class="pipeline__stages">
        <div class="pipeline__stage">
          <h4>Input Layer</h4>
          <p>Networking, file loading, byte stream abstraction</p>
        </div>
        <div class="pipeline__stage">
          <h4>Parsing & Processing</h4>
          <p>HTML5 tokenizer, CSS3 parser, DOM tree construction</p>
        </div>
        <div class="pipeline__stage">
          <h4>Style Computation</h4>
          <p>Cascade resolution, computed styles, custom properties</p>
        </div>
        <div class="pipeline__stage">
          <h4>Rendering Pipeline</h4>
          <p>Box model layout, render tree, pluggable draw backends</p>
        </div>
        <div class="pipeline__stage">
          <h4>Scripting Bridge</h4>
          <p>V8 integration, DOM API bindings, event loop</p>
        </div>
        <div class="pipeline__stage">
          <h4>Output Layer</h4>
          <p>Vello GPU, Cairo software, terminal debug mode</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STATUS -->
<section class="section" id="status">
  <div class="section__inner">
    <div class="section__header">
      <span class="section__label">Current Progress</span>
      <h2 class="section__title">Where We <em>Stand</em></h2>
    </div>
    
    <div class="status">
      <div class="status__text">
        <p>
          Gosub is in early development. We can parse HTML5 and CSS3, 
          render simple pages, and execute basic JavaScript.
        </p>
        <p>
          We can already render parts of our own site recognizably in the 
          Vello renderer. Every major component lives in its own crate.
        </p>
      </div>
      
      <div class="status__meters">
        {[
          { name: 'HTML5 Parser', val: '85%', w: '85%' },
          { name: 'CSS3 Parser', val: '70%', w: '70%' },
          { name: 'Document Tree', val: '60%', w: '60%' },
          { name: 'Layout Engine', val: '40%', w: '40%' },
          { name: 'GPU Renderer', val: '30%', w: '30%' },
          { name: 'JS Bridge', val: '20%', w: '20%' },
        ].map((item) => (
          <div class="status__meter">
            <div class="status__meter-head">
              <span class="status__meter-name">{item.name}</span>
              <span class="status__meter-val">{item.val}</span>
            </div>
            <div class="status__meter-bar">
              <div class="status__meter-fill" style={`width: ${item.w}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

