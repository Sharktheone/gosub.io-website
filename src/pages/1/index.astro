---
/**
 * DESIGN 1: BRUTALIST / RAW INDUSTRIAL
 * 
 * Aesthetic: Exposed structure, raw concrete textures, harsh monospace typography,
 * visible grid lines, red danger-accent on charcoal. Think construction site meets
 * hacker terminal. The memorable thing: the entire page feels like reading a
 * declassified engineering document.
 * 
 * Fonts: "IBM Plex Mono" (display + body) + "Anybody" (accent headlines)
 * Colors: Charcoal #1a1a1a bg, off-white #f0ece4 text, danger red #e63946 accent
 */
import Base from '../../layouts/Base.astro';
---

<Base title="Gosub — Modular Browser Engine [DESIGN 01: BRUTALIST]">

<style lang="scss">
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Anybody:wght@100;400;700;900&display=swap');

:root {
  --bg: #1a1a1a;
  --bg-light: #242424;
  --bg-elevated: #2e2e2e;
  --text: #f0ece4;
  --text-dim: #8a8580;
  --text-muted: #5e5a56;
  --accent: #e63946;
  --accent-dim: rgba(230, 57, 70, 0.15);
  --grid-color: rgba(240, 236, 228, 0.06);
  --border: rgba(240, 236, 228, 0.12);
  --mono: 'IBM Plex Mono', monospace;
  --display: 'Anybody', sans-serif;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--mono);
  font-size: 0.9375rem;
  line-height: 1.7;
  overflow-x: hidden;
  position: relative;
  
  // Grid overlay
  background-image:
    linear-gradient(var(--grid-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
  background-size: 60px 60px;
  background-position: -1px -1px;
}

// Grain texture overlay
body::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 128px;
}

::selection {
  background: var(--accent);
  color: var(--bg);
}

a {
  color: var(--accent);
  text-decoration: none;
  &:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
}

// ===== NAV =====
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border);
  background: rgba(26, 26, 26, 0.9);
  backdrop-filter: blur(10px);
  
  &__logo {
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
    
    &:hover { text-decoration: none; }
    
    span {
      color: var(--accent);
    }
  }
  
  &__links {
    display: flex;
    gap: 2rem;
    align-items: center;
    
    a {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      font-weight: 500;
      
      &:hover {
        color: var(--accent);
        text-decoration: none;
      }
    }
  }
}

// ===== HERO =====
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 8rem 2rem 4rem;
  position: relative;
  
  // Diagonal cut line
  &::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
  }
  
  &__inner {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    
    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }
  }
  
  &__label {
    display: inline-block;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.25rem 0.75rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: slideUp 0.6s 0.2s forwards;
  }
  
  &__title {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 2rem;
    opacity: 0;
    animation: slideUp 0.6s 0.4s forwards;
    
    .accent {
      color: var(--accent);
      display: block;
      font-size: 0.6em;
      letter-spacing: 0;
      line-height: 1.2;
      font-weight: 100;
    }
  }
  
  &__desc {
    font-size: 1rem;
    color: var(--text-dim);
    max-width: 480px;
    line-height: 1.8;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: slideUp 0.6s 0.6s forwards;
  }
  
  &__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: slideUp 0.6s 0.8s forwards;
  }
  
  &__blueprint {
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--text-muted);
    white-space: pre;
    padding: 2rem;
    border: 1px dashed var(--border);
    position: relative;
    opacity: 0;
    animation: fadeIn 1s 1s forwards;
    
    @media (max-width: 900px) {
      display: none;
    }
    
    &::before {
      content: 'ARCH/001 — ENGINE SCHEMATIC';
      position: absolute;
      top: -0.5rem;
      left: 1rem;
      background: var(--bg);
      padding: 0 0.5rem;
      font-size: 0.625rem;
      color: var(--accent);
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
  }
}

// ===== BUTTONS =====
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.875rem 1.75rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.15s;
  
  &--primary {
    background: var(--accent);
    color: var(--bg);
    
    &:hover {
      background: #ff4757;
      transform: translateY(-2px);
      text-decoration: none;
    }
  }
  
  &--secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    
    &:hover {
      border-color: var(--text);
      transform: translateY(-2px);
      text-decoration: none;
    }
  }
}

// ===== SECTION =====
.section {
  padding: 6rem 2rem;
  position: relative;
  
  &--dark {
    background: var(--bg-light);
  }
  
  &__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  &__header {
    margin-bottom: 4rem;
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }
  
  &__number {
    font-family: var(--display);
    font-weight: 900;
    font-size: 4rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.3;
    flex-shrink: 0;
  }
  
  &__label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.5rem;
  }
  
  &__title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
}

// ===== FEATURES GRID =====
.features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  
  &__item {
    background: var(--bg);
    padding: 2.5rem;
    position: relative;
    transition: background 0.2s;
    
    &:hover {
      background: var(--bg-light);
      
      .features__marker {
        background: var(--accent);
      }
    }
  }
  
  &__marker {
    width: 8px;
    height: 8px;
    background: var(--text-muted);
    margin-bottom: 1.5rem;
    transition: background 0.2s;
  }
  
  &__title {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  
  &__desc {
    font-size: 0.8125rem;
    color: var(--text-dim);
    line-height: 1.7;
  }
}

// ===== PIPELINE =====
.pipeline {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  
  &__stage {
    display: grid;
    grid-template-columns: 80px 200px 1fr;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
    
    @media (max-width: 768px) {
      grid-template-columns: 60px 1fr;
    }
    
    &:last-child {
      border-bottom: none;
    }
    
    &:hover {
      background: var(--bg-light);
      
      .pipeline__num {
        color: var(--accent);
      }
    }
  }
  
  &__num {
    padding: 1.5rem 1rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--text-muted);
    border-right: 1px solid var(--border);
    text-align: center;
    transition: color 0.2s;
  }
  
  &__name {
    padding: 1.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: center;
    
    @media (max-width: 768px) {
      border-right: none;
    }
  }
  
  &__details {
    padding: 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    line-height: 1.6;
    
    @media (max-width: 768px) {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }
}

// ===== STATUS =====
.status {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  
  @media (max-width: 900px) {
    grid-template-columns: 1fr;
  }
  
  &__text {
    p {
      color: var(--text-dim);
      margin-bottom: 1.5rem;
    }
  }
  
  &__bars {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  &__bar {
    &-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      
      span:last-child {
        color: var(--text-muted);
      }
    }
    
    &-track {
      height: 4px;
      background: var(--bg-elevated);
      position: relative;
    }
    
    &-fill {
      height: 100%;
      background: var(--accent);
      position: absolute;
      top: 0;
      left: 0;
      transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
}

// ===== CONTRIBUTE =====
.contribute {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  
  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
  
  &__col {
    background: var(--bg);
    padding: 3rem;
  }
  
  &__subtitle {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border);
  }
  
  &__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    
    li {
      font-size: 0.875rem;
      color: var(--text-dim);
      padding-left: 1.5rem;
      position: relative;
      
      &::before {
        content: '//';
        position: absolute;
        left: 0;
        color: var(--accent);
        font-weight: 600;
      }
    }
  }
  
  &__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    
    a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.8125rem;
      font-weight: 500;
      transition: all 0.15s;
      
      &:hover {
        border-color: var(--accent);
        background: var(--accent-dim);
        text-decoration: none;
        
        .arrow {
          transform: translateX(4px);
          color: var(--accent);
        }
      }
      
      .arrow {
        color: var(--text-muted);
        transition: all 0.15s;
      }
    }
  }
}

// ===== FOOTER =====
.footer {
  padding: 3rem 2rem;
  border-top: 2px solid var(--accent);
  
  &__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  &__copy {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  
  &__links {
    display: flex;
    gap: 1.5rem;
    
    a {
      font-size: 0.75rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      
      &:hover {
        color: var(--accent);
      }
    }
  }
}

// ===== ANIMATIONS =====
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

// ===== SCROLLBAR =====
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: var(--bg);
}
::-webkit-scrollbar-thumb {
  background: var(--text-muted);
}
</style>

<!-- NAV -->
<nav class="nav">
  <a href="/1" class="nav__logo">GO<span>SUB</span></a>
  <div class="nav__links">
    <a href="#features">Features</a>
    <a href="#architecture">Architecture</a>
    <a href="#status">Status</a>
    <a href="https://github.com/gosub-io/gosub-engine">GitHub</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero__inner">
    <div>
      <span class="hero__label">Open Source // MIT Licensed</span>
      <h1 class="hero__title">
        GOSUB
        <span class="accent">Gateway to Optimized Searching and Unlimited Browsing</span>
      </h1>
      <p class="hero__desc">
        A truly modular browser engine built from scratch in Rust. No forks. No baggage. 
        Just clean, composable components that put you in control.
      </p>
      <div class="hero__actions">
        <a href="https://github.com/gosub-io/gosub-engine" class="btn btn--primary">GET THE CODE</a>
        <a href="#community" class="btn btn--secondary">JOIN DEVELOPMENT</a>
      </div>
    </div>
    
    <pre class="hero__blueprint">{`
┌─────────────────────────────────┐
│  GOSUB ENGINE v0.1              │
│  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  │
│                                 │
│  INPUT LAYER                    │
│  ├── networking    [HTTP/S]     │
│  ├── file_loader   [LOCAL]      │
│  └── stream        [BYTES]      │
│                                 │
│  PARSE + PROCESS                │
│  ├── html5_parser  [TOKENIZE]   │
│  ├── css3_parser   [AST]        │
│  └── doc_tree      [DOM]        │
│                                 │
│  STYLE COMPUTATION              │
│  ├── css_engine    [CASCADE]    │
│  ├── style_tree    [COMPUTED]   │
│  └── custom_props  [VARS]       │
│                                 │
│  RENDER PIPELINE                │
│  ├── layout        [BOX MODEL]  │
│  ├── render_tree   [DISPLAY]    │
│  └── draw_backend  [GPU/CPU]    │
│                                 │
│  OUTPUT                         │
│  ├── vello         [GPU]        │
│  ├── cairo         [SOFTWARE]   │
│  └── terminal      [TEXT]       │
│                                 │
└──── MODULAR ─── COMPOSABLE ─────┘
    `}</pre>
  </div>
</section>

<!-- FEATURES -->
<section class="section" id="features">
  <div class="section__inner">
    <div class="section__header">
      <span class="section__number">01</span>
      <div>
        <span class="section__label">Differentiators</span>
        <h2 class="section__title">Built different.<br/>On purpose.</h2>
      </div>
    </div>
    
    <div class="features">
      <article class="features__item">
        <div class="features__marker"></div>
        <h3 class="features__title">Modular by design</h3>
        <p class="features__desc">Trait-based architecture — swap out the JS engine, renderer, or layout system without forking.</p>
      </article>
      <article class="features__item">
        <div class="features__marker"></div>
        <h3 class="features__title">Multiple render backends</h3>
        <p class="features__desc">GPU-accelerated (Vello) or CPU-based (Cairo). Pluggable renderers — your choice.</p>
      </article>
      <article class="features__item">
        <div class="features__marker"></div>
        <h3 class="features__title">Written in Rust</h3>
        <p class="features__desc">Memory-safe, built from scratch — not a wrapper around existing engines.</p>
      </article>
      <article class="features__item">
        <div class="features__marker"></div>
        <h3 class="features__title">Community-driven</h3>
        <p class="features__desc">No corporate backing, MIT licensed, built entirely by volunteers.</p>
      </article>
      <article class="features__item">
        <div class="features__marker"></div>
        <h3 class="features__title">Breaking the monoculture</h3>
        <p class="features__desc">The web deserves more than three engines. We're building the fourth — one module at a time.</p>
      </article>
      <article class="features__item">
        <div class="features__marker"></div>
        <h3 class="features__title">Web Standards First</h3>
        <p class="features__desc">We follow specs, not existing implementations. Better compatibility long-term.</p>
      </article>
    </div>
  </div>
</section>

<!-- ARCHITECTURE -->
<section class="section section--dark" id="architecture">
  <div class="section__inner">
    <div class="section__header">
      <span class="section__number">02</span>
      <div>
        <span class="section__label">Pipeline</span>
        <h2 class="section__title">The engine,<br/>deconstructed.</h2>
      </div>
    </div>
    
    <div class="pipeline">
      <div class="pipeline__stage">
        <div class="pipeline__num">01</div>
        <div class="pipeline__name">Input Layer</div>
        <div class="pipeline__details">Networking stack for HTTP/S, file loader for local resources, abstracted stream interface for any byte source.</div>
      </div>
      <div class="pipeline__stage">
        <div class="pipeline__num">02</div>
        <div class="pipeline__name">Parsing</div>
        <div class="pipeline__details">Standards-compliant HTML5 tokenizer/parser with full tree construction. CSS3 tokenizer and AST generation for stylesheets.</div>
      </div>
      <div class="pipeline__stage">
        <div class="pipeline__num">03</div>
        <div class="pipeline__name">Style Engine</div>
        <div class="pipeline__details">CSS selector matching, cascade resolution, computed styles attached to document nodes with custom property support.</div>
      </div>
      <div class="pipeline__stage">
        <div class="pipeline__num">04</div>
        <div class="pipeline__name">Layout</div>
        <div class="pipeline__details">Box model calculation, positioning, and render tree construction. Active development: Flexbox, Grid.</div>
      </div>
      <div class="pipeline__stage">
        <div class="pipeline__num">05</div>
        <div class="pipeline__name">Rendering</div>
        <div class="pipeline__details">Pluggable drawing backends — Vello (GPU via wgpu), Cairo (CPU fallback), terminal/text mode for debugging.</div>
      </div>
      <div class="pipeline__stage">
        <div class="pipeline__num">06</div>
        <div class="pipeline__name">Scripting</div>
        <div class="pipeline__details">JavaScript engine interface via V8 integration. DOM API bindings and event loop — in progress.</div>
      </div>
    </div>
  </div>
</section>

<!-- STATUS -->
<section class="section" id="status">
  <div class="section__inner">
    <div class="section__header">
      <span class="section__number">03</span>
      <div>
        <span class="section__label">Progress</span>
        <h2 class="section__title">Where we are today.</h2>
      </div>
    </div>
    
    <div class="status">
      <div class="status__text">
        <p>
          Gosub is in early development. We can parse HTML5 and CSS3, render simple pages, 
          and execute basic JavaScript. There's a long road ahead — and that's exactly 
          why we need contributors.
        </p>
        <p>
          We can already render parts of our own site recognizably in the Vello renderer. 
          Every major component lives in its own crate with minimal dependencies.
        </p>
      </div>
      
      <div class="status__bars">
        {[
          { label: 'HTML5 Parser', value: '85%', width: '85%' },
          { label: 'CSS3 Parser', value: '70%', width: '70%' },
          { label: 'Document Tree', value: '60%', width: '60%' },
          { label: 'Layout Engine', value: '40%', width: '40%' },
          { label: 'Vello Renderer', value: '30%', width: '30%' },
          { label: 'JS Bridge', value: '20%', width: '20%' },
        ].map((item) => (
          <div class="status__bar">
            <div class="status__bar-label">
              <span>{item.label}</span>
              <span>{item.value}</span>
            </div>
            <div class="status__bar-track">
              <div class="status__bar-fill" style={`width: ${item.width}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

