---

import Logo from "../logo.astro"
import Gradient from "./gradient.astro"
---

<section class="contribution">
    <div class="md:p-3 rounded-md">
        <h2 class="text-3xl mb-2">
            Join us and contribute today!
        </h2>
        <p class="mb-3 mt-3 text-justify text-white">
            Become part of our open-source community and help shape the future of browsing.
        </p>
        <div class="buttons">
            <a href="https://github.com/gosub-io/gosub-engine" class="button github">Github</a>
            <a href="https://chat.developer.gosub.io" class="button zulip">Zulip</a>
        </div>
    </div>
    <!--<div class="sm:basis-1/3 p-2">-->
    <!--    <p class="min-h-48 p float-end">-->
    <!--        <Logo size={200} />-->
    <!--    </p>-->
    <!--</div>-->
    <Gradient src="/gradients/logo-bg.svg" width={348} height={242} top={-10} scale={1.4}/>
</section>

<style>

    .github {
        background-color: black;
        color: white;
        border: 2px solid white;
    }

    .zulip {
        background-color: #F2F2F2;
        color: black;
    }

    .learn-more {
        background-color: black;
        color: white;
        border: 2px solid white;
    }

    .contribute {
        background-color: #F2F2F2;
        color: black;
    }

</style>


