---

import Logo from "../logo.astro"
import Gradient from "./gradient.astro"
import {Image} from "astro:assets";
---


<div class="contribute">
    <div>
        <h2>
            Join us and contribute today!
        </h2>
        <p>
            Become part of our open-source community and help shape the future of browsing.
        </p>
        <div class="buttons">
            <a href="https://github.com/gosub-io/gosub-engine" class="button github">
                <Image class="align-center" src="/icons/github.svg" alt="Github" width="32" height="32" />
                Github
            </a>
            <a href="https://chat.developer.gosub.io" class="button zulip">
                <Image class="align-center" src="/icons/zulip.svg" alt="Zulip" width="32" height="32" />
                Zulip
            </a>
        </div>
    </div>
    <div class="logo">
        <Logo size={512} />
        <Gradient src="/gradients/logo-bg.svg" width={848} height={842} top={-10} scale={1.7}/>
    </div>
</div>


<style>
    h2, p {
        max-width: 32rem;
        margin-top: 0;
    }


    .contribute {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4rem;
    }

    .buttons {
        display: flex;
        gap: 2rem;
        width: 50rem;
    }

    .github {
        color: white;
        background-color: black;
        border: 2px solid white;
    }

    .align-center {
        vertical-align: middle;
        text-align: center;
        align-items: center;
    }

    .zulip {
        color: white;
        background-color: black;
        border: 2px solid white;
    }

    .logo {
        position: relative;
    }

</style>


