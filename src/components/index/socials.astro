---
import { Image } from 'astro:assets';
---


<div class="socials">
    <ul class="center">
        <li>
            <a href="https://chat.gosub.io">
                <Image src="/icons/discord.svg" alt="Discord" width="32" height="32" />
            </a>
        </li>
        <li>
            <a href="https://github.com/gosub-io/gosub-engine">
                <Image src="/icons/github.svg" alt="Github" width="32" height="32" />
            </a>
        </li>
        <li>
            <a href="https://chat.developer.gosub.io">
                <Image src="/icons/zulip.svg" alt="Zulip" width="32" height="32" />
            </a>
        </li>

    </ul>
</div>



<style>
    .center {
        margin: auto;
    }

    .socials {
        margin-bottom: 1rem;
    }

    a {
        margin: 0;
    }

    ul {
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0 2rem;
        padding: 0;
        width: 16rem;
    }

    a {
        color: white;
        text-decoration: none;
        margin: 0 10px;
        font-size: 1.25rem;
        font-weight: normal;
    }

</style>
