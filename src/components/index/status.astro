---
import Gradient from "./gradient.astro"
---

<section class="status">
    <Gradient src="/gradients/status-left.svg" width={1416} height={2118} top={-48} left={-36} scale={1.2}/>
    <div class="md:p-3 rounded-md">
        <h2 class="text-3xl mb-2">
            Current status of the project
        </h2>
        <p class="mb-3 mt-3 text-justify text-white">
            The project is still in its early stages. We are working on the core components of the engine like the CSS
            system, rendering pipeline and JS integration. We are also working on the architecture of the engine to make
            it as modular as possible.
        </p>
        <div class="buttons">
            <a class="button read-more" href="/status">&raquo; Read more</a>
        </div>
    </div>
</section>

<style>
    .status {
        padding: 4rem;
        display: flex;
        justify-content: space-between;
        position: relative;
    }

    .read-more {
        background-color: black;
        color: white;
        border: 2px solid white;
    }
</style>
